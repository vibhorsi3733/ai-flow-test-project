# ---------------------------------------------------------------
# Motion-ai — IPL live highlights (toss → end of powerplay)
# Copy to .env and fill in.
# ---------------------------------------------------------------

# --- Source -----------------------------------------------------
SRT_URL=srt://0.0.0.0:9000?mode=listener&latency=200000
WORK_DIR=runtime
OUTPUT_DIR=output
MATCH_CONFIG_PATH=config/match.json
# true = after a restart, append to the recorded runtime files instead of archiving them
RESUME=false
# Reconnect the ingest (kill + restart ffmpeg) when no new segment arrives for this many seconds
INGEST_STALL_SECONDS=20

# --- OCR (optional) ---------------------------------------------
# true  -> scoreboard OCR is the primary source for runs/wickets/overs
#          (needs config/scoreboard.json + `pip install -r requirements-ocr.txt`)
# false -> commentary (speech-to-text + LLM) + crowd audio are the sources
OCR_AVAILABLE=false
OCR_CONFIG_PATH=config/scoreboard.json
OCR_FPS=2
OCR_USE_GPU=true
# Seconds the on-screen score typically updates AFTER the actual ball
OCR_LAG_SECONDS=6

# --- Speech-to-text ---------------------------------------------
ASR_MODEL=large-v3-turbo
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
# Leave empty for auto-detect (Hindi/English mix). Or: en / hi
ASR_LANGUAGE=
# CPU threads for speech-to-text (0 = all cores)
ASR_CPU_THREADS=0

# --- LLM (Claude) -----------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=low

# --- Highlights -------------------------------------------------
POWERPLAY_OVERS=6
HIGHLIGHT_TARGET_SECONDS=240
# Safety net: force powerplay end this many minutes after innings start
POWERPLAY_MAX_MINUTES=45
EXCITEMENT_Z=2.5
# libx264 (CPU) or h264_nvenc (NVIDIA GPU)
VIDEO_ENCODER=libx264

# powerplay = toss -> end of powerplay (default) | match = whole input, both innings, with cards
# match needs OCR_AVAILABLE=true (only scoreboard-confirmed clips are shown): startup fails otherwise
HIGHLIGHT_SCOPE=powerplay

# Only these overs of each batting team (both scopes). Empty = every over.
# JSON array; "overs" is an "a-b" range, a list of overs, or a mix: ["1-6", 20]. Overs 1..20.
# Team names must match config/match.json "teams"; innings 1 = match.json "batting_first".
# A team that is not listed keeps all its overs. Clips outside the selection are listed in
# withheld[] with reason not_selected_over, and their wickets do not count as missing.
# e.g. HIGHLIGHT_OVERS=[{"team":"Triumph Knights","overs":"1-6"},{"team":"Eagle Thane Strikers","overs":[1,2,16,17,18,19,20]}]
HIGHLIGHT_OVERS=
